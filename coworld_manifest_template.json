{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/coworld/schema/coworld_manifest.schema.json",
  "tags": [
    "battlecode",
    "strategy",
    "mixed-motive",
    "wasm"
  ],
  "episode_timeout_minutes": 20,
  "game": {
    "name": "battlecode",
    "description": "Battlecode, played by doctrine. Two cogs each write one sealed JSON strategy sheet and a deterministic Nim port of an official Battlecode rule set plays the whole match from those two sheets. Variant `bc26` is 2026 \"Uneasy Alliances\" — rat clans allied against NPC cats until one of them betrays. Variant `bc20` is 2020 \"Soup\" — the water rises every round, and a team either terraforms its way above the flood, walls its HQ in, or buries the enemy's under fifty units of dirt.",
    "owner": "daveey@gmail.com",
    "replay_viewer": {
      "bundle": "static-replay-viewer"
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/cogame-battlecode/blob/main/docs/PROTOCOL.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/cogame-battlecode/blob/main/docs/PROTOCOL.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/cogame-battlecode/blob/main/README.md"
      },
      "pages": [
        {
          "id": "rules.md",
          "title": "Rules, knobs and deliberate divergences",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/cogame-battlecode/blob/main/docs/RULES.md"
          }
        },
        {
          "id": "rules-bc20.md",
          "title": "Battlecode 2020 \"Soup\": rules, knobs and divergences",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/cogame-battlecode/blob/main/docs/RULES-BC20.md"
          }
        },
        {
          "id": "replay.md",
          "title": "Replay format",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/cogame-battlecode/blob/main/docs/REPLAY.md"
          }
        },
        {
          "id": "parity.md",
          "title": "The Java oracle and what it proves",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/cogame-battlecode/blob/main/docs/PARITY.md"
          }
        }
      ]
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "players"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player slot, indexed by slot.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "string",
          "enum": [
            "bc26",
            "bc20"
          ]
        },
        "pool": {
          "type": "string",
          "enum": [
            "small",
            "mixed",
            "large"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "gamesPerMatch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 50,
          "maximum": 2000
        },
        "num_agents": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
        "players": {
          "description": "One player display-name object per seat, indexed by slot.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        },
        "attempt1Ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "retryMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "doctrineBudgetMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "perGameBudgetSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "matchBudgetSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "connectTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "model": {
          "type": "string"
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        }
      }
    },
