 import {BCAbstractRobot, SPECS} from 'battlecode';
 
 var step = -1;
+
+// HUNK 1 (docs/PARITY.md #bc19). The stock line below drew its direction
+// from `Math.random()`, which is seeded from the wall clock -- so the stock
+// bot is NOT REPRODUCIBLE EVEN AGAINST ITSELF and no bit-exact parity is
+// possible with it. It is replaced by a `java.util.Random` SEEDED FROM THE
+// ROBOT'S OWN ID, created once per robot on its first draw. A
+// java.util.Random is chosen rather than a second Mersenne Twister so the
+// Nim port can reuse `src/battlecode/rng.nim` UNCHANGED -- and Tier A'' is
+// then also a test of that module against a SECOND, INDEPENDENT stream
+// running alongside the engine's own MT19937.
+function JavaRandom(seed) {
+    this.seed = (BigInt(seed) ^ 0x5DEECE66Dn) & ((1n << 48n) - 1n);
+}
+JavaRandom.prototype.next = function (bits) {
+    this.seed = (this.seed * 0x5DEECE66Dn + 0xBn) & ((1n << 48n) - 1n);
+    return Number(BigInt.asIntN(32, this.seed >> BigInt(48 - bits)));
+};
+JavaRandom.prototype.nextDouble = function () {
+    var hi = this.next(26);
+    var lo = this.next(27);
+    return (hi * 134217728 + lo) / 9007199254740992;
+};
+var rngs = {};
+function rngFor(id) {
+    if (!rngs[id]) rngs[id] = new JavaRandom(id);
+    return rngs[id];
+}
 
