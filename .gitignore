# Build outputs
/battlecode
/battlecode-player
/dist/
/replay-viewer/dist/
/static-replay-viewer/
nimcache/
*.exe

# The committed nim.cfg pins the AUTHOR's package paths and is wrong on every
# other host; the Dockerfile and ci.yml both regenerate it from the synced
# ~/.nimby/pkgs tree, so it is never committed.
nim.cfg

# Local scratch
/tmp/
*.log

# Python bytecode from the CI-time tools
__pycache__/
*.pyc

# Local node_modules from `npm install --no-save playwright` when running
# tools/ci/viewer_smoke.mjs by hand. CI installs it fresh every run.
/node_modules/
/package-lock.json
